{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/.netlify/functions/:name", "destination": "/api/netlify/:name" },
    { "source": "/api/vla/public-data", "destination": "/api/netlify/public-data" },
    { "source": "/api/vla/report-payment", "destination": "/api/netlify/public-report-payment" },
    { "source": "/api/vla/payment-reports/status", "destination": "/api/netlify/public-payment-report-status" },
    { "source": "/api/vla/payment-reports/supplement", "destination": "/api/netlify/public-payment-report-supplement" },
    { "source": "/api/vla/payment-proof", "destination": "/api/netlify/_admin_payment_proof" },
    { "source": "/api/vla/payment-report-analyzer", "destination": "/api/netlify/payment-report-analyzer-background" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [ { "key": "Cache-Control", "value": "no-store" } ]
    },
    {
      "source": "/.netlify/functions/(.*)",
      "headers": [ { "key": "Cache-Control", "value": "no-store" } ]
    },
    {
      "source": "/release.json",
      "headers": [ { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" } ]
    }
  ]
}
